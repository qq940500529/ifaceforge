    "scan": ["portable manifest", "service configuration", "SDK registrations", "protocol method evidence"],
    "sourceLanguages": {
      "typedRegistration": ["JavaScript", "TypeScript", "Python FastMCP"],
      "syntaxAndRecognizableRegistrations": [
        "Go",
        "Rust",
        "Java",
        "Kotlin",
        "C#",
        "C",
        "C++",
        "Swift",
        "Ruby",
        "PHP",
        "Scala",
        "Dart",
        "Bash",
        "Lua",
        "Elixir",
        "OCaml"
      ],
      "protocolEvidence": ["F#", "PowerShell", "Batch", "R", "Julia", "Erlang", "Haskell", "Perl"]
    },
    "auth": "Explicit request headers or environment references for temporary local HTTP endpoints",
    "runtimeExtensions": {
      "interactiveClientRequests": "reported as unsupported when requested",
      "subscriptionsAndTasks": "not part of capability discovery and direct capability tests"
    },
    "comparison": "committed definitions",
    "operations": ["tools", "resources", "resourceTemplates", "prompts"]
  },
  "skills": {
    "format": "Agent Skills SKILL.md",
